# Server-side only — never sent to the browser
GEMINI_API_KEY="your_google_gemini_api_key"

# 32-byte hex key for AES-256-GCM vault encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
VAULT_ENCRYPTION_KEY="your_64_char_hex_key_here"

# Supabase — browser-safe (VITE_ prefix required by Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
